---
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import type { AlbumCardProps } from "./types";
import { Icon } from "astro-icon/components";

const { album } = Astro.props as AlbumCardProps;
---

<a
	href={`/albums/${album.id}/`}
	data-tags={album.tags?.join(",") || ""}
	class="album-card relative block overflow-hidden rounded-xl transition-shadow duration-300 hover:shadow-xl"
>
	<!-- Cover Image -->
	<div
		class="album-cover-shell aspect-4/3 relative overflow-hidden"
		data-progressive-image-shell
		data-loaded={album.cover ? "false" : "error"}
	>
		{
			album.cover ? (
				<>
					<div class="album-image-skeleton" aria-hidden="true">
						<div class="album-image-skeleton-shine" />
					</div>
					<img
						src={album.cover}
						alt={album.title}
						class="album-cover-image w-full h-full object-cover pointer-events-none"
						loading="lazy"
						decoding="async"
						data-progressive-image
					/>
					<div class="album-image-error" aria-hidden="true">
						<Icon
							name="material-symbols:broken-image-outline-rounded"
							class="text-4xl"
						/>
					</div>
				</>
			) : (
				<div class="w-full h-full bg-[var(--btn-regular-bg)] flex items-center justify-center">
					<Icon
						name="material-symbols:photo-library"
						class="text-5xl text-black/20 dark:text-white/20"
					/>
				</div>
			)
		}

		<!-- Photo count badge -->
		<div
			class="absolute top-2 right-2 px-2 py-1 rounded-full text-xs text-white font-medium bg-black/50 backdrop-blur-sm"
		>
			{album.photos.length}
			{i18n(I18nKey.albumsPhotosCount)}
		</div>

		<!-- Gradient overlay + info -->
		<div
			class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"
		>
		</div>
		<div class="absolute bottom-0 left-0 right-0 p-4">
			<h3
				class="font-bold text-base text-white line-clamp-1 drop-shadow-lg"
			>
				{album.title}
			</h3>

			{
				album.description && (
					<p
						class="text-xs text-white/75 line-clamp-1 mt-1 leading-relaxed"
						title={album.description}
					>
						{album.description}
					</p>
				)
			}

			<div
				class="flex items-center gap-3 text-xs text-white/70 mt-1.5 flex-wrap"
			>
				{
					album.date && (
						<span>
							{new Date(album.date).toLocaleDateString("zh-CN")}
						</span>
					)
				}
				{
					album.location && (
						<span class="inline-flex items-center gap-0.5">
							<svg
								class="w-3 h-3"
								viewBox="0 0 24 24"
								fill="currentColor"
							>
								<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z" />
							</svg>
							{album.location}
						</span>
					)
				}
			</div>

			{
				album.tags && album.tags.length > 0 && (
					<div class="flex flex-wrap gap-1 mt-2">
						{album.tags.slice(0, 4).map((tag: string) => (
							<span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-white/20 text-white/90 backdrop-blur-sm">
								{tag}
							</span>
						))}
					</div>
				)
			}
		</div>
	</div>
</a>

<style>
	.album-card {
		animation: fadeInUp 0.5s ease-out forwards;
		opacity: 0;
	}

	.album-card.filtered-out {
		display: none;
	}

	.album-cover-shell {
		isolation: isolate;
		background: color-mix(in oklab, var(--card-bg-alt) 88%, var(--line-color));
	}

	.album-image-skeleton {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		background:
			linear-gradient(
				135deg,
				color-mix(in oklab, var(--card-bg-alt) 78%, white 22%) 0%,
				color-mix(in oklab, var(--line-color) 72%, white 28%) 100%
			),
			color-mix(in oklab, var(--card-bg-alt) 88%, var(--line-color));
		box-shadow:
			inset 0 0 0 1px
				color-mix(in oklab, var(--line-color) 70%, transparent),
			inset 0 18px 42px color-mix(in oklab, white 44%, transparent);
		transition:
			opacity 520ms ease,
			visibility 520ms ease;
	}

	.album-image-skeleton-shine {
		position: absolute;
		inset: 0 -45%;
		border-radius: inherit;
		background:
			linear-gradient(
				105deg,
				transparent 0%,
				transparent 34%,
				color-mix(in oklab, white 68%, transparent) 47%,
				transparent 62%,
				transparent 100%
			),
			radial-gradient(
				circle at top left,
				color-mix(in oklab, var(--primary) 11%, transparent) 0%,
				transparent 54%
			),
			linear-gradient(
				135deg,
				color-mix(in oklab, var(--line-color) 42%, transparent),
				color-mix(in oklab, white 28%, transparent)
			);
		animation: albumImageSkeletonPulse 1.2s ease-in-out infinite;
	}

	.album-cover-shell .album-cover-image {
		opacity: 0;
		transition:
			opacity 560ms ease,
			transform 500ms ease;
	}

	.album-cover-shell[data-loaded="true"] .album-cover-image {
		opacity: 1;
	}

	.album-card:hover .album-cover-image {
		transform: scale(1.05);
	}

	.album-cover-shell[data-loaded="true"] .album-image-skeleton,
	.album-cover-shell[data-loaded="error"] .album-image-skeleton {
		opacity: 0;
		visibility: hidden;
	}

	.album-image-error {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--content-meta);
		background: color-mix(in oklab, var(--btn-regular-bg) 88%, white 12%);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 260ms ease,
			visibility 260ms ease;
	}

	.album-cover-shell[data-loaded="error"] .album-image-error {
		opacity: 1;
		visibility: visible;
	}

	:global(.dark) .album-image-skeleton {
		background:
			linear-gradient(
				135deg,
				color-mix(in oklab, var(--card-bg) 84%, black 16%) 0%,
				color-mix(in oklab, var(--line-color) 74%, black 26%) 100%
			),
			color-mix(in oklab, var(--card-bg) 90%, black 10%);
		box-shadow:
			inset 0 0 0 1px
				color-mix(in oklab, var(--line-color) 78%, transparent),
			inset 0 18px 42px color-mix(in oklab, black 24%, transparent);
	}

	:global(.dark) .album-image-skeleton-shine {
		background:
			linear-gradient(
				105deg,
				transparent 0%,
				transparent 34%,
				color-mix(in oklab, white 18%, transparent) 47%,
				transparent 62%,
				transparent 100%
			),
			radial-gradient(
				circle at top left,
				color-mix(in oklab, var(--primary) 16%, transparent) 0%,
				transparent 54%
			),
			linear-gradient(
				135deg,
				color-mix(in oklab, var(--line-color) 52%, transparent),
				color-mix(in oklab, black 16%, transparent)
			);
	}

	@keyframes albumImageSkeletonPulse {
		0%,
		100% {
			opacity: 0.58;
			transform: translateX(-18%);
		}
		50% {
			opacity: 1;
			transform: translateX(18%);
		}
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.album-card:nth-child(1) {
		animation-delay: 0.03s;
	}
	.album-card:nth-child(2) {
		animation-delay: 0.06s;
	}
	.album-card:nth-child(3) {
		animation-delay: 0.09s;
	}
	.album-card:nth-child(4) {
		animation-delay: 0.12s;
	}
	.album-card:nth-child(5) {
		animation-delay: 0.15s;
	}
	.album-card:nth-child(6) {
		animation-delay: 0.18s;
	}
	.album-card:nth-child(7) {
		animation-delay: 0.21s;
	}
	.album-card:nth-child(8) {
		animation-delay: 0.24s;
	}
	.album-card:nth-child(9) {
		animation-delay: 0.27s;
	}
	.album-card:nth-child(10) {
		animation-delay: 0.3s;
	}
	.album-card:nth-child(11) {
		animation-delay: 0.33s;
	}
	.album-card:nth-child(12) {
		animation-delay: 0.36s;
	}

	.line-clamp-1 {
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
